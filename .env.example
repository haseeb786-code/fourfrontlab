# ============================================================
# FOUR FRONT LAB — ENVIRONMENT CONFIGURATION
# ============================================================

# Database URL
# Default: Local SQLite database
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/fourfrontlab?schema=public"

# Admin Authentication Secret (change in production)
JWT_SECRET="four-front-lab-super-secure-production-jwt-key-2026"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000
